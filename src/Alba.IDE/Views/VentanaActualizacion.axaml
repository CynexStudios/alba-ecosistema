<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Alba.IDE.Views.VentanaActualizacion"
        Title="Actualizador Integrado — Xynex Code Editor"
        Width="640"
        Height="510"
        MinWidth="540"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FondoBaseBrush}"
        Foreground="{DynamicResource TextoPrincipalBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <!-- Encabezado -->
    <Border Grid.Row="0"
            Background="{DynamicResource FondoSuperficieBrush}"
            BorderBrush="{DynamicResource BordeSutilBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     x:Name="TxtTituloEstado"
                     Text="Comprobando actualizaciones..."
                     FontSize="16"
                     FontWeight="Bold" />
          <TextBlock Grid.Column="1"
                     x:Name="TxtVersiones"
                     Text="v5.0.0"
                     FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AcentoPrimarioBrush}"
                     VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="TxtEntorno"
                   FontSize="12"
                   Foreground="{DynamicResource TextoSecundarioBrush}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="TxtPaquete"
                   FontSize="11.5"
                   Foreground="{DynamicResource AcentoSecundarioBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Notas y Progreso -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">
      <TextBlock Grid.Row="0"
                 Text="Novedades de esta versión"
                 FontSize="12"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextoSecundarioBrush}" />

      <TextBox Grid.Row="1"
               x:Name="TxtNotas"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               Background="{DynamicResource FondoEditorBrush}"
               BorderBrush="{DynamicResource BordeSutilBrush}"
               Watermark="Aquí aparecerán las notas de la nueva versión cuando exista una actualización publicada." />

      <Border Grid.Row="2"
              Background="{DynamicResource FondoSuperficieBrush}"
              BorderBrush="{DynamicResource BordeSutilBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12,10">
        <StackPanel Spacing="6">
          <TextBlock x:Name="TxtProgreso"
                     Text="Listo para comprobar o actualizar."
                     FontSize="12"
                     Foreground="{DynamicResource TextoPrincipalBrush}"
                     TextWrapping="Wrap" />
          <ProgressBar x:Name="BarraProgreso"
                       Minimum="0"
                       Maximum="100"
                       Value="0"
                       Height="8" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Botones de acción -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
        <Button x:Name="BtnComprobar" Classes="ToolbarBtn" Content="Comprobar ahora" Click="AlComprobar" />
        <Button Classes="ToolbarBtn" Content="Ver en GitHub" Click="AlAbrirGitHub" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="BtnCancelar" Classes="ToolbarBtn" Content="Cerrar" Click="AlCerrar" />
        <Button x:Name="BtnActualizar"
                Classes="PrimaryBtn"
                Content="Descargar e instalar"
                IsEnabled="False"
                Click="AlDescargarEInstalar" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
