<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Alba.IDE.Views.DialogoEntradaTexto"
        Width="420"
        Height="175"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FondoSuperficieBrush}"
        Foreground="{DynamicResource TextoPrincipalBrush}">
  <StackPanel Margin="18" Spacing="12">
    <TextBlock x:Name="TxtEtiqueta" FontSize="13" FontWeight="SemiBold" Text="Nombre:" />
    <TextBox x:Name="TxtValor"
             Background="{DynamicResource FondoEditorBrush}"
             Foreground="{DynamicResource TextoPrincipalBrush}"
             BorderBrush="{DynamicResource BordeSutilBrush}"
             Watermark="Escribe aquí..." />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button Classes="ToolbarBtn" Content="Cancelar" Click="AlCancelar" />
      <Button Classes="PrimaryBtn" Content="Aceptar" IsDefault="True" Click="AlAceptar" />
    </StackPanel>
  </StackPanel>
</Window>
