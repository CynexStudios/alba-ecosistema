<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Alba.IDE.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <!-- Paleta predeterminada Visual Studio Pro 9.0 actualizada dinámicamente por GestorTemas -->
    <SolidColorBrush x:Key="FondoBaseBrush" Color="#181818" />
    <SolidColorBrush x:Key="FondoSuperficieBrush" Color="#252526" />
    <SolidColorBrush x:Key="FondoPanelBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="FondoBarraBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="FondoEditorBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="FondoLineaActualBrush" Color="#28282B" />
    <SolidColorBrush x:Key="FondoHoverBrush" Color="#323236" />
    <SolidColorBrush x:Key="BordeSutilBrush" Color="#3C3C42" />
    <SolidColorBrush x:Key="TextoPrincipalBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="TextoSecundarioBrush" Color="#B0B7C3" />
    <SolidColorBrush x:Key="TextoApagadoBrush" Color="#858585" />
    <SolidColorBrush x:Key="AcentoPrimarioBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="AcentoSecundarioBrush" Color="#3794FF" />
    <SolidColorBrush x:Key="ExitoColorBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="AdvertenciaColorBrush" Color="#CCA700" />
    <SolidColorBrush x:Key="ErrorColorBrush" Color="#F14C4C" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <!-- Contraste claro y consistente en controles interactivos -->
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextoPrincipalBrush}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource FondoEditorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextoPrincipalBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BordeSutilBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource FondoEditorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextoPrincipalBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BordeSutilBrush}" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource AcentoSecundarioBrush}" />
    </Style>

    <!-- Menús principales -->
    <Style Selector="Menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextoPrincipalBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextoPrincipalBrush}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Botones de barra -->
    <Style Selector="Button.ToolbarBtn">
      <Setter Property="Background" Value="{DynamicResource FondoSuperficieBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextoPrincipalBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BordeSutilBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.ToolbarBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FondoHoverBrush}" />
    </Style>

    <!-- Botón de acción primaria Visual Studio -->
    <Style Selector="Button.PrimaryBtn">
      <Setter Property="Background" Value="{DynamicResource AcentoPrimarioBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.PrimaryBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AcentoSecundarioBrush}" />
    </Style>

    <!-- Botón Ejecutar -->
    <Style Selector="Button.RunBtn">
      <Setter Property="Background" Value="#15803D" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#22C55E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.RunBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#16A34A" />
    </Style>

    <!-- Botón Detener -->
    <Style Selector="Button.StopBtn">
      <Setter Property="Background" Value="#991B1B" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#EF4444" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Botones de barra lateral (Activity Rail) -->
    <Style Selector="Button.RailBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.RailBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FondoHoverBrush}" />
    </Style>
    <Style Selector="Button.RailBtn.Activo">
      <Setter Property="Background" Value="{DynamicResource FondoHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AcentoSecundarioBrush}" />
    </Style>

    <!-- Botones de pestañas de panel inferior y derecho -->
    <Style Selector="Button.DockTabBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.DockTabBtn.Activo">
      <Setter Property="Foreground" Value="{DynamicResource AcentoSecundarioBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AcentoPrimarioBrush}" />
    </Style>

    <!-- Tarjetas interactivas -->
    <Style Selector="Button.CardBtn">
      <Setter Property="Background" Value="{DynamicResource FondoSuperficieBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextoPrincipalBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BordeSutilBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.CardBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FondoHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AcentoSecundarioBrush}" />
    </Style>
  </Application.Styles>
</Application>
