<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Alba.IDE.Views.DialogoDiffGit"
        Title="Diferencias Git — Xynex Code Editor 5.0"
        Width="780"
        Height="560"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FondoBaseBrush}"
        Foreground="{DynamicResource TextoPrincipalBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,10">
      <TextBlock x:Name="TxtRutaArchivo" FontSize="15" FontWeight="Bold" />
      <TextBlock x:Name="TxtSubtitulo" FontSize="12" Foreground="{DynamicResource TextoSecundarioBrush}" />
    </StackPanel>

    <Border Grid.Row="1"
            Background="{DynamicResource FondoEditorBrush}"
            BorderBrush="{DynamicResource BordeSutilBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <TextBox x:Name="TxtDiffContenido"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 BorderThickness="0"
                 Background="Transparent"
                 FontFamily="JetBrains Mono, Cascadia Mono, Consolas, monospace"
                 FontSize="12"
                 TextWrapping="NoWrap" />
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Classes="ToolbarBtn" Content="Copiar diff" Click="AlCopiar" />
      <Button Classes="PrimaryBtn" Content="Cerrar" Click="AlCerrar" />
    </StackPanel>
  </Grid>
</Window>
